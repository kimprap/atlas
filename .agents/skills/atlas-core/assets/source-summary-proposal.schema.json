{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/source-summary-proposal.schema.json",
  "title": "SourceSummaryProposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "metadata", "assessment", "claims", "links"],
  "properties": {
    "version": {"const": 1},
    "metadata": {"$ref": "#/$defs/metadata"},
    "assessment": {"$ref": "#/$defs/assessment"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/link"}
    }
  },
  "$defs": {
    "nonempty_text": {"type": "string", "minLength": 1},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "author", "publisher", "published", "source_kind"],
      "properties": {
        "title": {"$ref": "#/$defs/nonempty_text"},
        "author": {"$ref": "#/$defs/nonempty_text"},
        "publisher": {"$ref": "#/$defs/nonempty_text"},
        "published": {
          "anyOf": [
            {"const": "Unknown"},
            {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"}
          ]
        },
        "source_kind": {
          "enum": ["article", "paper", "repo", "thread", "video", "docs", "other"]
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "confidence",
        "evidence_strength",
        "practicality",
        "stability",
        "reuse_value",
        "recommended_posture"
      ],
      "properties": {
        "coverage": {"enum": ["complete", "partial", "failed"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "evidence_strength": {"enum": ["high", "medium", "low"]},
        "practicality": {"enum": ["high", "medium", "low", "n/a"]},
        "stability": {"enum": ["stable", "moving", "speculative"]},
        "reuse_value": {"enum": ["high", "medium", "low"]},
        "recommended_posture": {
          "enum": ["adopt", "trial", "watch", "reference-only", "ignore"]
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "ledger_id"],
      "properties": {
        "locator": {"$ref": "#/$defs/nonempty_text"},
        "ledger_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidence"],
      "properties": {
        "statement": {"$ref": "#/$defs/nonempty_text"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "relation", "locator", "ledger_id"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "relation": {"enum": ["canonical", "related", "cited"]},
        "locator": {"$ref": "#/$defs/nonempty_text"},
        "ledger_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      }
    }
  }
}
