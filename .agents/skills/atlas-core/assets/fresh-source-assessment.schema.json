{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/fresh-source-assessment.schema.json",
  "title": "FreshSourceAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "freeze",
    "packet",
    "capture",
    "identity_alignment",
    "page_form",
    "page_summary_adequacy",
    "resource_intent",
    "dimensions",
    "findings",
    "evidence",
    "review",
    "actions",
    "drift",
    "index"
  ],
  "properties": {
    "version": {"const": 1},
    "freeze": {"$ref": "#/$defs/freeze"},
    "packet": {"$ref": "#/$defs/packet"},
    "capture": {"$ref": "#/$defs/capture"},
    "identity_alignment": {"$ref": "#/$defs/identity_alignment"},
    "page_form": {"enum": ["standalone", "aggregate", "indeterminate", "not-applicable"]},
    "page_summary_adequacy": {"$ref": "#/$defs/page_summary_adequacy"},
    "resource_intent": {"$ref": "#/$defs/resource_intent"},
    "dimensions": {"$ref": "#/$defs/dimensions"},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "evidence": {"$ref": "#/$defs/evidence"},
    "review": {"$ref": "#/$defs/review"},
    "actions": {"$ref": "#/$defs/actions"},
    "drift": {"$ref": "#/$defs/drift"},
    "index": {"$ref": "#/$defs/index"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_id": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
    "url": {"type": "string", "pattern": "^https?://\\S+$"},
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_seq",
        "canonical_url",
        "manifest_row_hash",
        "artifact_revision",
        "snapshot_hash"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/source_id"},
        "source_seq": {"type": "integer", "minimum": 1},
        "canonical_url": {"$ref": "#/$defs/url"},
        "manifest_row_hash": {"$ref": "#/$defs/sha256"},
        "artifact_revision": {"$ref": "#/$defs/revision"},
        "snapshot_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_sha256",
        "capture_sha256",
        "text_blob_sha256",
        "ledger_sha256",
        "rubric_version"
      ],
      "properties": {
        "packet_sha256": {"$ref": "#/$defs/sha256"},
        "capture_sha256": {"$ref": "#/$defs/sha256"},
        "text_blob_sha256": {"$ref": "#/$defs/sha256"},
        "ledger_sha256": {"$ref": "#/$defs/sha256"},
        "rubric_version": {"const": 1}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "access",
        "representation",
        "text_blob_sha256",
        "final_url",
        "http_status"
      ],
      "properties": {
        "state": {"enum": ["completed", "pending-systemic", "invalid-input"]},
        "access": {"enum": ["available", "unauthorized", "inaccessible", "response-error"]},
        "representation": {
          "enum": ["readable-text", "empty", "non-text", "error-document", "not-applicable"]
        },
        "text_blob_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "final_url": {"anyOf": [{"$ref": "#/$defs/url"}, {"type": "null"}]},
        "http_status": {
          "anyOf": [{"type": "integer", "minimum": 100, "maximum": 599}, {"type": "null"}]
        }
      }
    },
    "identity_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalized_final_url", "page_declared_canonical", "evidence_strength"],
      "properties": {
        "normalized_final_url": {"enum": ["same", "different", "indeterminate"]},
        "page_declared_canonical": {"enum": ["same", "different", "indeterminate"]},
        "evidence_strength": {"enum": ["high", "medium", "low"]}
      }
    },
    "page_summary_adequacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "page_supports"],
      "properties": {
        "value": {"enum": ["sufficient", "insufficient", "unassessed"]},
        "page_supports": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "resource_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "declared_text", "provenance", "fit", "missing_for_resource_intent"],
      "properties": {
        "kind": {"enum": ["unknown", "page-itself", "declared"]},
        "declared_text": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "provenance": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "fit": {"enum": ["supports", "misses", "unassessed"]},
        "missing_for_resource_intent": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "declared"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "declared_text": {"type": "string", "minLength": 1},
              "provenance": {"type": "string", "minLength": 1}
            }
          },
          "else": {
            "properties": {
              "declared_text": {"type": "null"},
              "provenance": {"type": "null"}
            }
          }
        }
      ]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence_refs"],
      "properties": {
        "state": {"enum": ["pass", "fail", "unassessed"]},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture", "identity", "page_form", "adequacy", "intent"],
      "properties": {
        "capture": {"$ref": "#/$defs/dimension"},
        "identity": {"$ref": "#/$defs/dimension"},
        "page_form": {"$ref": "#/$defs/dimension"},
        "adequacy": {"$ref": "#/$defs/dimension"},
        "intent": {"$ref": "#/$defs/dimension"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "dimensions", "evidence_refs"],
      "properties": {
        "code": {
          "enum": [
            "aggregate",
            "thin-standalone",
            "canonical-mismatch",
            "inaccessible",
            "unauthorized",
            "empty",
            "non-text",
            "error-document",
            "insufficient",
            "response-error"
          ]
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["capture", "identity", "page_form", "adequacy", "intent"]}
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "excerpt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "blob_sha256", "start_byte", "end_byte", "excerpt_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "blob_sha256": {"$ref": "#/$defs/sha256"},
        "start_byte": {"type": "integer", "minimum": 0},
        "end_byte": {"type": "integer", "minimum": 1},
        "excerpt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonical_url",
        "source_id",
        "anchor",
        "locator",
        "normalization_status",
        "raw_href_sha256",
        "display",
        "reason"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "canonical_url": {"anyOf": [{"$ref": "#/$defs/url"}, {"type": "null"}]},
        "source_id": {"anyOf": [{"$ref": "#/$defs/source_id"}, {"type": "null"}]},
        "anchor": {"type": "string"},
        "locator": {"type": "string", "minLength": 1},
        "normalization_status": {"enum": ["accepted", "rejected"]},
        "raw_href_sha256": {"$ref": "#/$defs/sha256"},
        "display": {"type": "string", "minLength": 1},
        "reason": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excerpts", "links"],
      "properties": {
        "excerpts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/excerpt"}
        },
        "links": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/link"}
        }
      }
    },
    "review_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "assessment_sha256", "packet_sha256", "blinded", "verdict"],
      "properties": {
        "review_id": {"$ref": "#/$defs/identifier"},
        "assessment_sha256": {"$ref": "#/$defs/sha256"},
        "packet_sha256": {"$ref": "#/$defs/sha256"},
        "blinded": {"const": true},
        "verdict": {"enum": ["accepted", "flagged", "invalid", "ambiguous"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {"$ref": "#/$defs/review_record"},
        "secondary": {"anyOf": [{"$ref": "#/$defs/review_record"}, {"type": "null"}]}
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "recommended", "write_set"],
      "properties": {
        "allowed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "record-assessment",
              "ask-resource-intent",
              "ask-aggregate-scope",
              "queue-resolution",
              "no-write",
              "page-only",
              "add-companion",
              "replace",
              "defer"
            ]
          }
        },
        "recommended": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "record-assessment",
              "ask-resource-intent",
              "ask-aggregate-scope",
              "queue-resolution",
              "no-write",
              "page-only",
              "add-companion",
              "replace",
              "defer"
            ]
          }
        },
        "write_set": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["assessment-record", "intent-record", "candidate-record"]}
        }
      }
    },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen_manifest_row_hash", "observed_manifest_row_hash", "status"],
      "properties": {
        "frozen_manifest_row_hash": {"$ref": "#/$defs/sha256"},
        "observed_manifest_row_hash": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["same", "drifted"]}
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_index_sha256",
        "source_ids",
        "source_count",
        "terminal_count",
        "assessment_sha256",
        "review_sha256",
        "candidate_sha256"
      ],
      "properties": {
        "assessment_index_sha256": {"$ref": "#/$defs/sha256"},
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/source_id"}
        },
        "source_count": {"type": "integer", "minimum": 1},
        "terminal_count": {"type": "integer", "minimum": 0},
        "assessment_sha256": {"$ref": "#/$defs/sha256"},
        "review_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
