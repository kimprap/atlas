{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-workflow-result.schema.json",
  "title": "AtlasOwnerResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "owner", "outcome", "effect", "summary", "items", "next"],
  "properties": {
    "version": {"const": 1},
    "owner": {"enum": ["atlas-source", "atlas-research", "atlas-maintain"]},
    "outcome": {
      "enum": ["completed", "no-write", "needs-user", "needs-guidance", "blocked", "framework-defect"]
    },
    "effect": {"enum": ["none", "committed", "partial", "unknown"]},
    "summary": {"$ref": "#/$defs/nonempty"},
    "items": {"type": "array", "minItems": 1},
    "next": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/recovery"}
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "outcome": {"const": "completed"},
        "effect": {"enum": ["none", "committed"]},
        "items": {"$ref": "#/$defs/completed-items"},
        "next": {"type": "null"}
      }
    },
    {
      "properties": {
        "outcome": {"const": "no-write"},
        "effect": {"const": "none"},
        "items": {"$ref": "#/$defs/no-write-items"},
        "next": {"type": "null"}
      }
    },
    {
      "properties": {
        "outcome": {"const": "needs-user"},
        "effect": {"enum": ["none", "committed"]},
        "items": {"$ref": "#/$defs/question-items"},
        "next": {"type": "null"}
      }
    },
    {
      "properties": {
        "outcome": {"const": "needs-guidance"},
        "effect": {"enum": ["none", "committed"]},
        "items": {"$ref": "#/$defs/guidance-items"},
        "next": {"type": "null"}
      }
    },
    {
      "properties": {
        "outcome": {"const": "blocked"},
        "effect": {"enum": ["none", "committed"]},
        "items": {"$ref": "#/$defs/blocked-items"},
        "next": {"type": "null"}
      }
    },
    {
      "properties": {
        "outcome": {"const": "blocked"},
        "effect": {"enum": ["partial", "unknown"]},
        "items": {"$ref": "#/$defs/blocked-items"},
        "next": {"$ref": "#/$defs/recovery"}
      }
    },
    {
      "properties": {
        "outcome": {"const": "blocked"},
        "effect": {"const": "unknown"},
        "items": {
          "allOf": [
            {"$ref": "#/$defs/blocked-items"},
            {
              "items": {
                "properties": {
                  "recovery_required": {"const": true}
                }
              }
            }
          ]
        },
        "next": {"type": "null"}
      }
    },
    {
      "properties": {
        "outcome": {"const": "framework-defect"},
        "effect": {"enum": ["none", "committed"]},
        "items": {"$ref": "#/$defs/defect-items"},
        "next": {"type": "null"}
      }
    }
  ],
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "string-set": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonempty"}
    },
    "status-item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "summary"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "status": {"enum": ["completed", "no-write"]},
        "summary": {"$ref": "#/$defs/nonempty"}
      }
    },
    "completed-items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/status-item"},
          {"properties": {"status": {"const": "completed"}}}
        ]
      }
    },
    "no-write-items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/status-item"},
          {"properties": {"status": {"const": "no-write"}}}
        ]
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "recommended"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "label": {"$ref": "#/$defs/nonempty"},
        "description": {"$ref": "#/$defs/nonempty"},
        "recommended": {"type": "boolean"}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "multi", "options"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "question": {"$ref": "#/$defs/nonempty"},
        "multi": {"type": "boolean"},
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/option"},
          "contains": {
            "type": "object",
            "required": ["recommended"],
            "properties": {"recommended": {"const": true}}
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    "question-items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/question"}
    },
    "guidance-item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "evidence_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "question": {"$ref": "#/$defs/nonempty"},
        "evidence_refs": {"$ref": "#/$defs/string-set"}
      }
    },
    "guidance-items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/guidance-item"}
    },
    "blocked-item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "recovery_required"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "summary": {"$ref": "#/$defs/nonempty"},
        "recovery_required": {"type": "boolean"}
      }
    },
    "blocked-items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/blocked-item"}
    },
    "defect-item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "evidence_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "summary": {"$ref": "#/$defs/nonempty"},
        "evidence_refs": {
          "allOf": [
            {"$ref": "#/$defs/string-set"},
            {"minItems": 1}
          ]
        }
      }
    },
    "defect-items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/defect-item"}
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "identity"],
      "properties": {
        "operation": {"$ref": "#/$defs/nonempty"},
        "identity": {"$ref": "#/$defs/nonempty"}
      }
    }
  }
}
