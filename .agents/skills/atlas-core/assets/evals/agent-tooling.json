{
  "version": 1,
  "cases": [
    {
      "id": "owner-mode-source",
      "prompt": "Classify the sealed Atlas request without performing Atlas I/O.",
      "fixture": {"request": "Resummarize https://example.test/a"},
      "expected": {"owner": "atlas-source", "mode": "resummarize", "approval_required": true, "atlas_io": false}
    },
    {
      "id": "owner-mode-research",
      "prompt": "Classify the sealed Atlas request without performing Atlas I/O.",
      "fixture": {"request": "Research topic runtime-contracts from existing Atlas evidence"},
      "expected": {"owner": "atlas-research", "mode": "research", "approval_required": true, "atlas_io": false}
    },
    {
      "id": "owner-mode-maintain",
      "prompt": "Classify the sealed Atlas request without performing Atlas I/O.",
      "fixture": {"request": "Audit Atlas registries for structural integrity"},
      "expected": {"owner": "atlas-maintain", "mode": "audit", "approval_required": false, "atlas_io": false}
    },
    {
      "id": "read-only-presence-no-approval",
      "prompt": "Route one explicit source-presence request.",
      "fixture": {"request": "Is https://example.test/a already sourced?"},
      "expected": {"owner": "atlas-source", "mode": "presence", "approval_required": false, "operations": ["source.inventory"], "write_set": []}
    },
    {
      "id": "read-only-answer-no-approval",
      "prompt": "Route one topic answer request.",
      "fixture": {"request": "Answer topic runtime-contracts"},
      "expected": {"owner": "atlas-research", "mode": "answer", "approval_required": false, "operations": ["topic.inspect"], "write_set": []}
    },
    {
      "id": "write-one-approval",
      "prompt": "Render the write-capable routing boundary.",
      "fixture": {"owner": "atlas-source", "mode": "ingest", "approval_replies": ["approve"]},
      "expected": {"overview_sections": ["Goal", "Effect", "Approval"], "owner_loads": 1, "write_approvals": 1}
    },
    {
      "id": "ambiguous-batched-clarification",
      "prompt": "Classify an ambiguous topic request before approval.",
      "fixture": {"request": "Handle topic runtime-contracts"},
      "expected": {"owner": null, "questions": 1, "batched": true, "approval_rendered": false, "atlas_io": false}
    },
    {
      "id": "task-transport-absent",
      "prompt": "Continue one selected owner when nested Task transport is unavailable.",
      "fixture": {"owner": "atlas-research", "mode": "answer", "task_available": false},
      "expected": {"same_agent_execution": true, "capability_stop": false, "result_count": 1}
    },
    {
      "id": "discovery-lifecycle-default",
      "prompt": "Inspect default façade capabilities.",
      "fixture": {"command": "capabilities", "all": false},
      "expected": {"audiences": ["lifecycle"], "contains": ["source.normalize_capture", "topic.inspect", "research.execute"], "omits": ["vault.conditional_replace", "transaction.execute"]}
    },
    {
      "id": "discovery-all-audiences",
      "prompt": "Inspect complete façade capabilities.",
      "fixture": {"command": "capabilities", "all": true},
      "expected": {"audiences": ["internal", "lifecycle"], "contains": ["vault.conditional_replace", "transaction.execute", "topic.inspect"]}
    },
    {
      "id": "owner-result-completed",
      "prompt": "Validate the compact completed owner result.",
      "fixture": {"result": {"version": 1, "owner": "atlas-source", "outcome": "completed", "effect": "committed", "summary": "Source committed.", "items": [{"id": "a", "status": "completed", "summary": "Committed."}], "next": null}},
      "expected": {"schema_valid": true, "terminal": true, "transport_metadata": false}
    },
    {
      "id": "owner-result-no-write",
      "prompt": "Validate an observed no-write owner result.",
      "fixture": {"outcome": "no-write", "effect": "none", "next": null},
      "expected": {"schema_valid": true, "terminal": true}
    },
    {
      "id": "owner-result-needs-user",
      "prompt": "Validate one batched material question set.",
      "fixture": {"owner": "atlas-source", "outcome": "needs-user", "questions": 2, "recommended_per_question": 1},
      "expected": {"schema_valid": true, "resume_kind": "material", "batched": true}
    },
    {
      "id": "owner-result-needs-guidance",
      "prompt": "Validate one bounded missing-semantic set.",
      "fixture": {"owner": "atlas-maintain", "outcome": "needs-guidance", "questions": 1, "evidence_refs": ["rule://atlas-boundaries"]},
      "expected": {"schema_valid": true, "resume_kind": "guidance"}
    },
    {
      "id": "source-resume-ceiling",
      "prompt": "Apply invocation-local source resume limits.",
      "fixture": {"owner": "atlas-source", "needs_user": ["aggregate", "worker-choice"], "needs_guidance": 1},
      "expected": {"max_owner_turn": 4, "returned_attempt_metadata": false, "persisted_attempt_metadata": false}
    },
    {
      "id": "other-owner-resume-ceiling",
      "prompt": "Apply invocation-local research and maintenance resume limits.",
      "fixture": {"owners": ["atlas-research", "atlas-maintain"], "needs_guidance": 1},
      "expected": {"max_owner_turn": 2, "needs_user": 0, "returned_attempt_metadata": false}
    },
    {
      "id": "partial-blocks-exact-recovery",
      "prompt": "Classify a journal-proven incomplete apply.",
      "fixture": {"outcome": "blocked", "effect": "partial", "next": {"operation": "research.recover", "identity": "tx-1"}},
      "expected": {"schema_valid": true, "blocked": true, "hidden_retry": false, "recovery_exact": true}
    },
    {
      "id": "unknown-completed-rejected",
      "prompt": "Reject an illegal terminal effect tuple.",
      "fixture": {"outcome": "completed", "effect": "unknown"},
      "expected": {"schema_valid": false, "blocked": true}
    },
    {
      "id": "source-inventory-contract",
      "prompt": "Select actionable source inventory entries.",
      "fixture": {"intents": ["presence", "routine", "resummarize"], "dispositions": ["new", "active-due", "active-not-due", "active", "archived", "duplicate", "rejected"]},
      "expected": {"presence_actionable": [], "routine_actionable": ["new", "active-due"], "resummarize_actionable": ["active"], "invented_dispositions": []}
    },
    {
      "id": "source-transaction-owner",
      "prompt": "Choose the persistence seam after source preparation.",
      "fixture": {"prepared": {"transaction": {"event_record": {}, "targets": []}}, "successor_eligible": true},
      "expected": {"operations": ["transaction.execute", "transaction.successor"], "effect_adapter_calls": 0}
    },
    {
      "id": "research-dirty-continuation",
      "prompt": "Execute approved research against a dirty topic.",
      "fixture": {"initial_state": "dirty", "mode": "research"},
      "expected": {"operations": ["topic.inspect", "refresh.execute", "topic.inspect", "research.prepare", "research.execute"], "research_requires_state": "current"}
    },
    {
      "id": "answer-dirty-no-write",
      "prompt": "Answer a valid dirty topic without refresh.",
      "fixture": {"state": "dirty", "mode": "answer", "pending_edge_ids": ["edge-a"]},
      "expected": {"outcome": "no-write", "effect": "none", "freshness_label": "dirty", "pending_edge_ids": ["edge-a"], "refresh_calls": 0, "write_calls": 0}
    },
    {
      "id": "framework-defect-terminal",
      "prompt": "Return one product defect without automatic engineering dispatch.",
      "fixture": {"outcome": "framework-defect", "effect": "none"},
      "expected": {"engineering_dispatch": 0, "audit_verify_repair_loop": false, "result_count": 1}
    }
  ]
}
