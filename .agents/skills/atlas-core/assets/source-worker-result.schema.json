{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/source-worker-result.schema.json",
  "title": "SourceWorkerResult",
  "oneOf": [
    {"$ref": "#/$defs/ready"},
    {"$ref": "#/$defs/needs_input"},
    {"$ref": "#/$defs/expanded"},
    {"$ref": "#/$defs/no_write"}
  ],
  "$defs": {
    "nonempty_text": {"type": "string", "minLength": 1},
    "evidence_bundle": {
      "type": "object",
      "required": ["version", "canonical_url", "payload_text"],
      "properties": {
        "version": {"const": 1},
        "canonical_url": {"$ref": "#/$defs/nonempty_text"},
        "payload_text": {"$ref": "#/$defs/nonempty_text"},
        "first_seen": {"type": "string"},
        "fetched_at": {"type": "string"}
      },
      "additionalProperties": true
    },
    "ledger_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "absolute_http_url": {
      "type": "string",
      "pattern": "^https?://\\S+$"
    },
    "evidence_ledger_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "ledger_id"],
      "properties": {
        "locator": {"$ref": "#/$defs/nonempty_text"},
        "ledger_id": {"$ref": "#/$defs/ledger_id"}
      }
    },
    "evidence_ledger_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "locator", "ledger_id"],
      "properties": {
        "url": {"$ref": "#/$defs/absolute_http_url"},
        "locator": {"$ref": "#/$defs/nonempty_text"},
        "ledger_id": {"$ref": "#/$defs/ledger_id"}
      }
    },
    "evidence_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "evidence", "links"],
      "properties": {
        "version": {"const": 1},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_ledger_entry"}
        },
        "links": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_ledger_link"}
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_url", "source_id"],
      "properties": {
        "canonical_url": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "pattern": "^[0-9a-f]{12}$"}
      }
    },
    "checklist_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail"]},
        "evidence": {"$ref": "#/$defs/nonempty_text"}
      }
    },
    "checklist": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/checklist_item"}, {"properties": {"id": {"const": "evidence-boundary"}}}]},
        {"allOf": [{"$ref": "#/$defs/checklist_item"}, {"properties": {"id": {"const": "primary-contribution"}}}]},
        {"allOf": [{"$ref": "#/$defs/checklist_item"}, {"properties": {"id": {"const": "source-support"}}}]},
        {"allOf": [{"$ref": "#/$defs/checklist_item"}, {"properties": {"id": {"const": "limits-uncertainty"}}}]},
        {"allOf": [{"$ref": "#/$defs/checklist_item"}, {"properties": {"id": {"const": "context-neutrality"}}}]},
        {"allOf": [{"$ref": "#/$defs/checklist_item"}, {"properties": {"id": {"const": "assessment-coherence"}}}]},
        {"allOf": [{"$ref": "#/$defs/checklist_item"}, {"properties": {"id": {"const": "proportionality"}}}]}
      ],
      "items": false
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "kind", "identity", "evidence_bundle", "evidence_ledger", "proposal", "checklist", "refresh_after"],
      "properties": {
        "version": {"const": 1},
        "kind": {"const": "ready"},
        "identity": {"$ref": "#/$defs/identity"},
        "evidence_bundle": {"$ref": "#/$defs/evidence_bundle"},
        "evidence_ledger": {"$ref": "#/$defs/evidence_ledger"},
        "proposal": {"$ref": "source-summary-proposal.schema.json"},
        "checklist": {"$ref": "#/$defs/checklist"},
        "refresh_after": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "needs_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "kind", "identity", "reason", "choices"],
      "properties": {
        "version": {"const": 1},
        "kind": {"const": "needs-input"},
        "identity": {"$ref": "#/$defs/identity"},
        "reason": {"$ref": "#/$defs/nonempty_text"},
        "choices": {
          "oneOf": [
            {"const": ["page-only", "expand", "stop-without-writing"]},
            {"const": ["replacement-input", "bounded-acquisition", "stop-without-writing"]}
          ]
        }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "reference"],
      "properties": {
        "label": {"$ref": "#/$defs/nonempty_text"},
        "reference": {"$ref": "#/$defs/nonempty_text"}
      }
    },
    "expanded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "kind", "identity", "children"],
      "properties": {
        "version": {"const": 1},
        "kind": {"const": "expanded"},
        "identity": {"$ref": "#/$defs/identity"},
        "children": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/child"}}
      }
    },
    "no_write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "kind", "identity", "reason"],
      "properties": {
        "version": {"const": 1},
        "kind": {"const": "no-write"},
        "identity": {"$ref": "#/$defs/identity"},
        "reason": {"$ref": "#/$defs/nonempty_text"}
      }
    }
  }
}
